# GEMINI_API_KEY: Required for the editor's AI prompt (served by /api/gemini).
# Server-side only: do NOT prefix with VITE_, or it would ship in the browser bundle.
#   Local dev:  copy this file to .env.local and put your key there (.env.local is gitignored).
#   Production: `npx vercel env add GEMINI_API_KEY production`
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional. Defaults to gemini-3.5-flash-lite (fast; the larger flash models were 15-35 s here).
# GEMINI_MODEL="gemini-3.5-flash-lite"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
